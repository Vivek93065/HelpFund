# Dependency directories
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets (NEVER commit secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Protect all environment files except the example
.env*
!.env.example

# SQLite databases and backups
data/*.db
data/*.db-*
data/*.bak
!data/.gitkeep

# User file uploads (store uploads locally, do not commit uploaded files)
uploads/*
!uploads/.gitkeep

# System and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
